# Copy to /etc/rotp/game-1.env (one file per game instance) and edit.
# Read by the rotp-game@.service systemd template.

# TCP port for this game. Give each instance its own: 8777, 8778, 8779, ...
ROTP_PORT=8777

# how many human slots. The game auto-starts once they are all filled; the host
# can also start early from the lobby and let AI fill the rest.
ROTP_PLAYERS=2

# tiny | small | medium | large | huge (the host can override this in the lobby)
ROTP_SIZE=small

# seconds per turn before the server auto-resolves it, so one absent player
# cannot stall a we-go turn. 0 = no deadline.
ROTP_TIMER=300

# Listen on loopback only, because Caddy terminates TLS and proxies to us (see
# docs/deployment.md). Set to 0.0.0.0 only if this JVM serves wss:// itself.
ROTP_BIND=127.0.0.1
